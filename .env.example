# Render Postgres: keycloak-db (Oregon / US West, PostgreSQL 16)
# Use INTERNAL hostname when Keycloak runs on Render (same account/region).

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://dpg-d9l5osb7u1mc739tm94g-a:5432/keycloak_v39s
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# Set on the Render web service (runtime; not baked into the image).
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME=your-service.onrender.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Optional: local connectivity test from your machine (External URL from Render Connections tab).
# DATABASE_URL=postgresql://keycloak:YOUR_PASSWORD@dpg-d9l5osb7u1mc739tm94g-a.oregon-postgres.render.com:5432/keycloak_v39s
